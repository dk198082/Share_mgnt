{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:certificates": "tsx --test src/lib/certificates.test.ts",
    "test:history": "tsx --test src/lib/history.test.ts",
    "test:reports": "tsx --test src/lib/reports.test.ts",
    "test:settings": "tsx --test src/lib/settings.test.ts",
    "test:directories": "tsx --test src/lib/directories.test.ts",
    "test:approvals": "tsx --test src/lib/approval-workflow.test.ts src/lib/identity-lookup.test.ts",
    "test:share-prices": "tsx --test src/lib/share-prices.test.ts",
    "test:settings-audit": "tsx --test src/lib/settings-audit.test.ts",
    "test:notifications": "tsx --test src/lib/signoff-notifications.test.ts",
    "test:certificate-pdfs": "tsx --test src/lib/certificate-pdf.test.ts",
    "test:object-storage": "tsx --test src/lib/object-storage.test.ts src/lib/sharepoint-storage.test.ts",
    "migrate:sharepoint": "tsx src/scripts/migrate-sharepoint.ts",
    "migrate:azure-objects": "tsx src/scripts/migrate-object-storage.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@clerk/express": "^2.1.78",
    "@clerk/shared": "^4.40.0",
    "@google-cloud/storage": "^8.4.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.0",
    "http-proxy-middleware": "^4.2.0",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
